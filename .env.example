# Fabdesk environment (copy to .env; every value is optional). Bun and electron-vite read .env from the
# directory they run in, so use `export` or a per-app .env for dev runs. See docs/ for details.

# --- Error reporting (docs/sentry.md). Off unless a DSN is set. ---
# Runtime DSN for the Electron main process and (forwarded) the core daemon. Public write-only key.
# Legacy spelling FABDESK_SENTRY_DSN still works. SENTRY_DSN is fabplane's server DSN and is not read.
#SENTRY_DESKTOP_DSN=https://PUBLIC_KEY@o0.ingest.us.sentry.io/0
# Build-time DSN inlined into the desktop main bundle by `bun run --cwd apps/desktop build` (CI sets it
# from the SENTRY_DESKTOP_DSN repo secret; `apps/core` build reads SENTRY_DESKTOP_DSN as a compile-time define).
#VITE_SENTRY_DESKTOP_DSN=https://PUBLIC_KEY@o0.ingest.us.sentry.io/0
# Environment tag; defaults to production for packaged/compiled builds and development otherwise.
#SENTRY_ENVIRONMENT=staging
#VITE_SENTRY_ENVIRONMENT=staging
# Release override; defaults to fabdesk@<version>+<git-sha> / fabdesk-core@<version>+<git-sha>.
#SENTRY_RELEASE=
#VITE_SENTRY_RELEASE=
# 1 = each runtime sends one handled test event at startup and prints its id (docs/sentry.md).
#FABDESK_SENTRY_TEST=1

# --- Core daemon (apps/core/src/main.ts `fabdesk-core help`) ---
#FABDESK_HOME=            # config/data dir (default: platform app-support dir)
#FABDESK_CHANNEL=public   # public | internal
#FABDESK_AUTH_MODE=       # local | fabplane
#FABPLANE_API_ORIGIN=https://api.fabplane.com
#FABDESK_PROJECTS_DIR=~/Fabdesk
#FABDESK_LOG=info         # debug | info | warn | error

# --- Desktop (apps/desktop/src/main) ---
#FABDESK_CORE_BIN=        # run this daemon binary instead of the bundled/dev one
#FABDESK_UPDATE_URL=      # override the update feed
#FABDESK_UPDATE_CHECK=1   # 0 disables the update check
# Unpackaged `bun run dev` is "fabPlane Dev" (separate userData, lock, core home, port) so it can
# run next to an installed production copy. 1 = force that profile on a packaged nightly;
# 0 = force the production identity even when unpackaged. See docs/dev-loop.md.
#FABDESK_DEV_PROFILE=1
#FABDESK_DEV_PORT=47831   # fixed port for the isolated dev core (0 = random)
