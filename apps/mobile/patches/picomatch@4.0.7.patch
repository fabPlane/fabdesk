+// Reject an unbounded wildcard inside a repeated extglob, including a single
+// branch (GHSA-fc5q-39xc-vjpf). Escapes and bracket classes are bounded literals.
+const hasUnboundedWildcard = branch => {
+  let bracket = false;
+  for (let i = 0; i < branch.length; i++) {
+    if (branch[i] === '\\') { i++; continue; }
+    if (branch[i] === '[') { bracket = true; continue; }
+    if (branch[i] === ']') { bracket = false; continue; }
+    if (!bracket && branch[i] === '*') return true;
+  }
+  return false;
+};
