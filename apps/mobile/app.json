{
  "expo": {
    "name": "fabPlane",
    "slug": "fabplane-mobile",
    "scheme": "fabdesk",
    "version": "0.1.0",
    "owner": "voxly",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    },
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fabplane.fabdesk",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanning the pairing code shown by fabPlane on your computer.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connecting to fabPlane running on your computer over your local network or tailnet."
      },
      "appleTeamId": "CMNZZ92926"
    },
    "android": {
      "package": "com.tensorfleet.fabdesk.mobile",
      "versionCode": 1,
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c2726"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanning the pairing code shown by fabPlane on your computer."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attaching a photo to a chat so the agent can see it.",
          "cameraPermission": "Taking a photo to attach to a chat so the agent can see it."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "runs",
          "icon": "./assets/notification-icon.png",
          "color": "#8bc37a"
        }
      ]
    ],
    "extra": {
      "eas": {}
    },
    "icon": "./assets/icon.png"
  }
}
