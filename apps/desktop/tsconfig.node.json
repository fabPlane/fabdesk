{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "electron-vite/node"
    ],
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "electron.vite.config.ts",
    "scripts/**/*.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
