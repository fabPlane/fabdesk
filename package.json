{
  "name": "fabdesk",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.x"
  },
  "workspaces": [
    "apps/core",
    "apps/desktop",
    "apps/relay",
    "packages/*",
    "vendor/fabplane-cli",
    "vendor/fabplane/packages/shared",
    "vendor/fabplane/packages/config",
    "vendor/fabplane/packages/auth",
    "vendor/fabplane/packages/storage",
    "vendor/fabplane/packages/pcb",
    "vendor/fab_pcb/packages/proto",
    "vendor/fab_pcb/packages/client",
    "vendor/fab_pcb/packages/kicad-wasm",
    "vendor/fab_cad/packages/protocol",
    "vendor/fab_cad/packages/client",
    "vendor/fab_cad/packages/mock-server",
    "vendor/fab_cad/packages/bridge"
  ],
  "trustedDependencies": [
    "electron",
    "electron-builder",
    "esbuild"
  ],
  "overrides": {
    "hono": "4.13.7",
    "fast-xml-parser": "5.11.1",
    "nanoid": "3.3.19",
    "lodash-es": "4.18.1",
    "proxy-addr": "2.0.8"
  },
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:pcb": "bun run scripts/dev-pcb.ts",
    "dev:cad": "bun run scripts/dev-cad.ts",
    "dev:core": "bun run --cwd apps/core dev",
    "relay": "bun run --cwd apps/relay start",
    "typecheck": "bun run fp-pcb:types && bun run fab-cad:types && bun run --filter './apps/core' --filter './apps/desktop' --filter './apps/relay' --filter './packages/*' typecheck",
    "test": "bun run --filter './apps/core' --filter './apps/desktop' --filter './apps/relay' --filter './packages/*' test && bun test ./scripts/test",
    "build:core": "bun run --cwd apps/core build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "package": "bun run build:core && bun run --cwd apps/desktop package",
    "cad:stage": "bun run scripts/stage-cad-bundle.ts",
    "cad:smoke": "bun run scripts/smoke-cad-bundle.ts",
    "kicad:stage": "bun run scripts/stage-kicad-bundle.ts",
    "doctor": "bun run --cwd apps/core doctor",
    "submodules:update": "git submodule update --remote --merge vendor/fabplane vendor/fab_pcb vendor/fabplane-cli",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "security:scan": "bun run scripts/security-scan.ts",
    "security:issues": "bun run scripts/security-issues.ts",
    "vm:mac": "bash scripts/vm/mac.sh",
    "vm:linux": "bash scripts/vm/linux.sh",
    "vm:windows": "bash scripts/vm/windows.sh",
    "pr:relevance": "bun run scripts/pr-relevance.ts",
    "regressions:boards": "bun run scripts/board-regressions.ts",
    "regressions:boards:pr": "bun run scripts/board-regressions.ts --tier pr",
    "regressions:boards:nightly": "bun run scripts/board-regressions.ts --tier nightly",
    "runs:export": "bun run scripts/export-agent-run.ts",
    "usage:backup": "bun run scripts/backup-usage-data.ts",
    "fp-pcb:types": "tsc -b vendor/fab_pcb/packages/client",
    "fab-cad:types": "tsc -b vendor/fab_cad/packages/client",
    "mobile:install": "bun install --cwd apps/mobile",
    "mobile:typecheck": "bun run --cwd apps/mobile typecheck",
    "mobile:test": "bun run --cwd apps/mobile test",
    "mobile": "bun run --cwd apps/mobile start"
  },
  "devDependencies": {
    "@types/bun": "1.2.21",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "patchedDependencies": {
    "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
  }
}
