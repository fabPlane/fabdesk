# Included via CMAKE_PROJECT_INCLUDE on the Windows weekly build (MSYS2 UCRT64).
# Upstream CMakePresets.json has no Windows preset; the `base` preset prepends
# /usr/bin to PATH and Warnings.cmake is GCC-only (-Wall), so we do not use
# MSVC or clang-cl. This shim:
#   - static libgcc / libstdc++
#   - force libzstd.a (reject a zstd DLL, same idea as macos-static-deps.cmake)
#   - prefer static libsqlite3.a when TM / SQLite3_* point at one
# User-defined function calls require parentheses:
#   fabdesk_collect_targets(_child "${_s}")
# A bare `fabdesk_collect_targets _child` is a parse error.

function(fabdesk_windows_static_runtime)
  add_link_options(-static-libgcc -static-libstdc++)
  add_compile_definitions(_WIN32_WINNT=0x0A00)
endfunction()

function(fabdesk_require_static_zstd_archive_win)
  if(NOT TM_ZSTD_LIBRARY)
    message(FATAL_ERROR "fabdesk: TM_ZSTD_LIBRARY is empty; pass -DTM_ZSTD_LIBRARY=/path/to/libzstd.a")
  endif()
  if(NOT EXISTS "${TM_ZSTD_LIBRARY}")
    message(FATAL_ERROR "fabdesk: libzstd.a not found at ${TM_ZSTD_LIBRARY}")
  endif()
  if(TM_ZSTD_LIBRARY MATCHES "\\.dll(\\.a)?$")
    message(FATAL_ERROR "fabdesk: refusing ${TM_ZSTD_LIBRARY} — Windows zstd DLLs are not allowed")
  endif()
endfunction()

function(fabdesk_import_static_zstd_win)
  fabdesk_require_static_zstd_archive_win()
  foreach(_name zstd::libzstd_static zstd::libzstd_shared zstd::libzstd)
    if(NOT TARGET ${_name})
      add_library(${_name} STATIC IMPORTED GLOBAL)
      set_target_properties(${_name} PROPERTIES IMPORTED_LOCATION "${TM_ZSTD_LIBRARY}")
      if(TM_ZSTD_INCLUDE_DIR)
        set_target_properties(${_name} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${TM_ZSTD_INCLUDE_DIR}")
      endif()
    endif()
  endforeach()
endfunction()

function(fabdesk_zstd_location_is_dll name)
  set(_fabdesk_zstd_dll FALSE PARENT_SCOPE)
  if(NOT TARGET ${name})
    return()
  endif()
  get_target_property(_loc ${name} IMPORTED_LOCATION)
  if(_loc AND _loc MATCHES "\\.dll")
    set(_fabdesk_zstd_dll TRUE PARENT_SCOPE)
  endif()
endfunction()

function(fabdesk_retarget_zstd_win tgt)
  if(NOT TARGET ${tgt})
    return()
  endif()
  get_target_property(_type ${tgt} TYPE)
  if(NOT _type)
    return()
  endif()
  set(_props INTERFACE_LINK_LIBRARIES)
  if(NOT _type STREQUAL "INTERFACE_LIBRARY")
    list(APPEND _props LINK_LIBRARIES)
  endif()
  foreach(_prop ${_props})
    get_target_property(_libs ${tgt} ${_prop})
    if(NOT _libs)
      continue()
    endif()
    set(_new "")
    set(_changed FALSE)
    foreach(_lib ${_libs})
      if(_lib STREQUAL "zstd::libzstd_shared" OR _lib STREQUAL "zstd::libzstd")
        list(APPEND _new zstd::libzstd_static)
        set(_changed TRUE)
      else()
        list(APPEND _new "${_lib}")
      endif()
    endforeach()
    if(_changed)
      set_property(TARGET ${tgt} PROPERTY ${_prop} "${_new}")
      message(STATUS "fabdesk: ${tgt} ${_prop} now uses zstd::libzstd_static (${TM_ZSTD_LIBRARY})")
    endif()
  endforeach()
endfunction()

function(fabdesk_collect_targets out dir)
  get_property(_here DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  set(_acc "${${out}}")
  list(APPEND _acc ${_here})
  get_property(_subs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(_s ${_subs})
    set(_child "")
    fabdesk_collect_targets(_child "${_s}")
    list(APPEND _acc ${_child})
  endforeach()
  set(${out} "${_acc}" PARENT_SCOPE)
endfunction()

function(fabdesk_prefer_static_zstd_win)
  fabdesk_import_static_zstd_win()
  set(_targets "")
  fabdesk_collect_targets(_targets "${CMAKE_SOURCE_DIR}")
  foreach(_tgt ${_targets})
    fabdesk_retarget_zstd_win(${_tgt})
  endforeach()
  if(TARGET tm_replay)
    get_target_property(_replay_libs tm_replay LINK_LIBRARIES)
    if(NOT _replay_libs)
      set(_replay_libs "")
    endif()
    if(NOT "zstd::libzstd_static" IN_LIST _replay_libs)
      list(APPEND _replay_libs zstd::libzstd_static)
      set_property(TARGET tm_replay PROPERTY LINK_LIBRARIES "${_replay_libs}")
    endif()
    message(STATUS "fabdesk: tm_replay links zstd::libzstd_static (${TM_ZSTD_LIBRARY})")
  endif()
  foreach(_name zstd::libzstd_static zstd::libzstd_shared zstd::libzstd)
    fabdesk_zstd_location_is_dll(${_name})
    if(_fabdesk_zstd_dll)
      message(FATAL_ERROR
        "fabdesk: ${_name} still points at a DLL. "
        "zstd_DIR must be scripts/tracemaker/cmake/zstd-static and TM_ZSTD_LIBRARY must be libzstd.a.")
    endif()
  endforeach()
endfunction()

if(WIN32 OR TM_WINDOWS_STATIC)
  fabdesk_windows_static_runtime()
  if(TM_ZSTD_LIBRARY)
    fabdesk_import_static_zstd_win()
    cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL fabdesk_prefer_static_zstd_win)
  endif()
endif()
