# Included via CMAKE_PROJECT_INCLUDE on the macOS manual build.
# Run 38009143938: Homebrew's zstd CMake config has no zstd::libzstd_static,
# so tm_replay linked /opt/homebrew/opt/zstd/lib/libzstd.1.dylib.
# We also pass -Dzstd_DIR at a config that imports libzstd.a under both
# zstd::libzstd_static and zstd::libzstd_shared (upstream prefers shared).
# This file fails configure if that archive is missing or still a dylib.
# User-defined function calls require parentheses:
#   fabdesk_collect_targets(_child "${_s}")
# A bare `fabdesk_collect_targets _child` is a parse error (run 38013328567).

function(fabdesk_require_static_zstd_archive)
  if(NOT TM_ZSTD_LIBRARY)
    message(FATAL_ERROR "fabdesk: TM_ZSTD_LIBRARY is empty; pass -DTM_ZSTD_LIBRARY=/path/to/libzstd.a")
  endif()
  if(NOT EXISTS "${TM_ZSTD_LIBRARY}")
    message(FATAL_ERROR "fabdesk: libzstd.a not found at ${TM_ZSTD_LIBRARY}")
  endif()
  if(TM_ZSTD_LIBRARY MATCHES "\\.dylib$")
    message(FATAL_ERROR "fabdesk: refusing ${TM_ZSTD_LIBRARY} — Homebrew zstd dylibs are not allowed")
  endif()
endfunction()

function(fabdesk_import_static_zstd)
  fabdesk_require_static_zstd_archive()
  foreach(_name zstd::libzstd_static zstd::libzstd_shared zstd::libzstd)
    if(NOT TARGET ${_name})
      add_library(${_name} STATIC IMPORTED GLOBAL)
      set_target_properties(${_name} PROPERTIES IMPORTED_LOCATION "${TM_ZSTD_LIBRARY}")
      if(TM_ZSTD_INCLUDE_DIR)
        set_target_properties(${_name} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${TM_ZSTD_INCLUDE_DIR}")
      endif()
    endif()
  endforeach()
endfunction()

function(fabdesk_zstd_location_is_dylib name)
  set(_fabdesk_zstd_dylib FALSE PARENT_SCOPE)
  if(NOT TARGET ${name})
    return()
  endif()
  get_target_property(_loc ${name} IMPORTED_LOCATION)
  if(_loc AND _loc MATCHES "\\.dylib$")
    set(_fabdesk_zstd_dylib TRUE PARENT_SCOPE)
  endif()
endfunction()

# Rewrite one target's link props so zstd::libzstd_shared / zstd::libzstd
# become zstd::libzstd_static. Only touches targets that already link zstd.
function(fabdesk_retarget_zstd tgt)
  if(NOT TARGET ${tgt})
    return()
  endif()
  get_target_property(_type ${tgt} TYPE)
  if(NOT _type)
    return()
  endif()
  set(_props INTERFACE_LINK_LIBRARIES)
  if(NOT _type STREQUAL "INTERFACE_LIBRARY")
    list(APPEND _props LINK_LIBRARIES)
  endif()
  foreach(_prop ${_props})
    get_target_property(_libs ${tgt} ${_prop})
    if(NOT _libs)
      continue()
    endif()
    set(_new "")
    set(_changed FALSE)
    foreach(_lib ${_libs})
      if(_lib STREQUAL "zstd::libzstd_shared" OR _lib STREQUAL "zstd::libzstd")
        list(APPEND _new zstd::libzstd_static)
        set(_changed TRUE)
      else()
        list(APPEND _new "${_lib}")
      endif()
    endforeach()
    if(_changed)
      set_property(TARGET ${tgt} PROPERTY ${_prop} "${_new}")
      message(STATUS "fabdesk: ${tgt} ${_prop} now uses zstd::libzstd_static (${TM_ZSTD_LIBRARY})")
    endif()
  endforeach()
endfunction()

function(fabdesk_collect_targets out dir)
  get_property(_here DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
  set(_acc "${${out}}")
  list(APPEND _acc ${_here})
  get_property(_subs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
  foreach(_s ${_subs})
    set(_child "")
    fabdesk_collect_targets(_child "${_s}")
    list(APPEND _acc ${_child})
  endforeach()
  set(${out} "${_acc}" PARENT_SCOPE)
endfunction()

function(fabdesk_prefer_static_zstd)
  fabdesk_import_static_zstd()
  set(_targets "")
  fabdesk_collect_targets(_targets "${CMAKE_SOURCE_DIR}")
  foreach(_tgt ${_targets})
    fabdesk_retarget_zstd(${_tgt})
  endforeach()
  if(TARGET tm_replay)
    get_target_property(_replay_libs tm_replay LINK_LIBRARIES)
    if(NOT _replay_libs)
      set(_replay_libs "")
    endif()
    if(NOT "zstd::libzstd_static" IN_LIST _replay_libs)
      list(APPEND _replay_libs zstd::libzstd_static)
      set_property(TARGET tm_replay PROPERTY LINK_LIBRARIES "${_replay_libs}")
    endif()
    message(STATUS "fabdesk: tm_replay links zstd::libzstd_static (${TM_ZSTD_LIBRARY})")
  endif()
  foreach(_name zstd::libzstd_static zstd::libzstd_shared zstd::libzstd)
    fabdesk_zstd_location_is_dylib(${_name})
    if(_fabdesk_zstd_dylib)
      message(FATAL_ERROR
        "fabdesk: ${_name} still points at a dylib. "
        "zstd_DIR must be scripts/tracemaker/cmake/zstd-static and TM_ZSTD_LIBRARY must be libzstd.a.")
    endif()
  endforeach()
endfunction()

fabdesk_import_static_zstd()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL fabdesk_prefer_static_zstd)
