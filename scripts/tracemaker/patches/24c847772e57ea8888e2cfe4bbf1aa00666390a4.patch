# Commit-pinned macOS patch for DingoOz/TraceMaker v0.9.0
# (24c847772e57ea8888e2cfe4bbf1aa00666390a4). Applied only when HEAD matches.
# Replaces std::from_chars(double) — deleted in Apple libc++ before macOS 26 —
# with a C-locale strtod helper so the binary can keep minos 15.0.
#
# Sites grepped in that commit (all double/float):
#   src/sexpr/sexpr.cpp:145
#   src/sexpr/sexpr.cpp:337
#   src/route/layer_limits.cpp:43
#   src/io/kicad/project_reader.cpp:30
--- a/src/core/from_chars_double.hpp
+++ b/src/core/from_chars_double.hpp
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Fabdesk macOS build helper. Apple libc++ before macOS 26 deletes
+// std::from_chars(double). This C-locale strtod path matches from_chars
+// "entire string consumed" semantics without requiring a newer minos.
+#pragma once
+
+#include <charconv>
+#include <string>
+#include <xlocale.h>
+
+namespace tmk {
+
+inline std::from_chars_result from_chars_double(const char* first, const char* last, double& value) {
+  if (first == nullptr || last == nullptr || first > last) {
+    return {first, std::errc::invalid_argument};
+  }
+  const std::string buf(first, static_cast<std::size_t>(last - first));
+  char* end = nullptr;
+  const locale_t loc = newlocale(LC_NUMERIC_MASK, "C", static_cast<locale_t>(0));
+  if (loc == static_cast<locale_t>(0)) {
+    return {first, std::errc::invalid_argument};
+  }
+  value = strtod_l(buf.c_str(), &end, loc);
+  freelocale(loc);
+  if (end == buf.c_str()) {
+    return {first, std::errc::invalid_argument};
+  }
+  const auto consumed = static_cast<std::size_t>(end - buf.c_str());
+  if (consumed != buf.size()) {
+    return {first + consumed, std::errc::invalid_argument};
+  }
+  return {last, std::errc{}};
+}
+
+}  // namespace tmk
