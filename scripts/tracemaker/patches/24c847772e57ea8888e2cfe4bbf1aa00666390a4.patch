# Commit-pinned macOS patch for DingoOz/TraceMaker v0.9.0
# (24c847772e57ea8888e2cfe4bbf1aa00666390a4). Applied only when HEAD matches.
#
# 1. Replaces std::from_chars(double) — deleted in Apple libc++ before macOS 26 —
#    with a locale-independent iostreams parse (std::locale::classic()) so the
#    binary can keep minos 15.0. Do not use strtod_l / newlocale: Homebrew LLVM
#    with -nostdinc++ does not declare them on macOS 15 (run 37999311656).
# 2. Adds #include <cstdlib> wherever upstream calls std::atof / std::atoi
#    without it. Homebrew LLVM libc++ does not put atof in namespace std via
#    transitive includes (run 38003551366: rule_engine.cpp:154).
#
# from_chars sites grepped in that commit (all double/float; no other from_chars in src/):
#   src/sexpr/sexpr.cpp:145
#   src/sexpr/sexpr.cpp:337
#   src/route/layer_limits.cpp:43
#   src/io/kicad/project_reader.cpp:30
# std::atof / std::atoi sites without <cstdlib>:
#   src/drc/rule_engine.cpp:154,208,209
#   src/route/router.cpp:3083
#   src/io/kicad/board_reader.cpp:236
#   src/server/view_main.cpp:408
diff --git a/src/core/from_chars_double.hpp b/src/core/from_chars_double.hpp
new file mode 100644
index 0000000..71048fd
--- /dev/null
+++ b/src/core/from_chars_double.hpp
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Fabdesk macOS build helper. Apple libc++ before macOS 26 deletes
+// std::from_chars(double). This classic-locale iostreams path matches
+// from_chars "entire string consumed" semantics without strtod_l.
+#pragma once
+
+#include <charconv>
+#include <cstddef>
+#include <ios>
+#include <locale>
+#include <sstream>
+#include <string>
+
+namespace tmk {
+
+inline std::from_chars_result from_chars_double(const char* first, const char* last, double& value) {
+  if (first == nullptr || last == nullptr || first > last) {
+    return {first, std::errc::invalid_argument};
+  }
+  if (first == last) {
+    return {first, std::errc::invalid_argument};
+  }
+  const std::string buf(first, static_cast<std::size_t>(last - first));
+  std::istringstream in(buf);
+  in.imbue(std::locale::classic());
+  in.unsetf(std::ios::skipws);
+  double parsed = 0;
+  if (!(in >> parsed)) {
+    return {first, std::errc::invalid_argument};
+  }
+  const std::streampos pos = in.tellg();
+  const std::size_t consumed =
+      (in.eof() || pos < static_cast<std::streampos>(0)) ? buf.size() : static_cast<std::size_t>(pos);
+  value = parsed;
+  if (consumed != buf.size()) {
+    return {first + consumed, std::errc::invalid_argument};
+  }
+  return {last, std::errc{}};
+}
+
+}  // namespace tmk
