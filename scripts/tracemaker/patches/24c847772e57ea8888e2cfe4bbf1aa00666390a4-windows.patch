# Commit-pinned Windows patch for DingoOz/TraceMaker v0.9.0
# (24c847772e57ea8888e2cfe4bbf1aa00666390a4). Applied only by
# scripts/tracemaker/apply-windows-patch.sh on the windows-x86_64 build.
# Linux and macOS do not apply this file.
#
# MSYS2 UCRT64 GCC, -std=c++20 (run 38075992766):
#   src/route/escape.cpp — the POSIX pi macro is undeclared unless
#     _USE_MATH_DEFINES is set before <cmath>. Use std::numbers::pi instead.
#   src/server/viewer_server.cpp — path::c_str() is const wchar_t* and
#     path::native() is std::wstring. Beast file_body::open wants const char*,
#     and mime_type wants std::string_view. Use path::string().
diff --git a/src/route/escape.cpp b/src/route/escape.cpp
index da5812e..a470901 100644
--- a/src/route/escape.cpp
+++ b/src/route/escape.cpp
@@ -9,6 +9,7 @@
 #include <cstdlib>
 #include <deque>
 #include <map>
+#include <numbers>
 
 namespace tmk::route {
 
@@ -21,7 +22,8 @@ std::pair<Coord, Coord> half_extents(const model::Pad& p) { return pad_half_exte
 }  // namespace
 
 std::pair<Coord, Coord> pad_half_extents(const model::Pad& p) {
-  const double a = p.angle * M_PI / 180.0;
+  // MinGW libstdc++ with -std=c++20 hides the POSIX pi macro (run 38075992766).
+  const double a = p.angle * std::numbers::pi / 180.0;
   const double c = std::fabs(std::cos(a)), s = std::fabs(std::sin(a));
   const double hx = c * static_cast<double>(p.size_x) / 2 + s * static_cast<double>(p.size_y) / 2;
   const double hy = s * static_cast<double>(p.size_x) / 2 + c * static_cast<double>(p.size_y) / 2;
